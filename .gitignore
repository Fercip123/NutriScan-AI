# =========================================
# NutriScan AI — .gitignore
# Gabungan: Python (ML) + Flutter (Mobile App)
# =========================================

# ---------- PYTHON / MACHINE LEARNING ----------

# Cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environment
venv/
env/
.venv/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Dataset foto — JANGAN diupload ke GitHub (ukurannya besar & bukan kode)
# Kalau mau share dataset, gunakan Google Drive/Kaggle lalu cantumkan link di README
ml-model/dataset/*/*.jpg
ml-model/dataset/*/*.jpeg
ml-model/dataset/*/*.png
ml-model/dataset/*/*.webp
ml-model/dataset/*/*.gif
ml-model/dataset/*/*.bmp
!ml-model/dataset/*/.gitkeep

# Model besar (.keras) — cukup simpan .tflite yang ringan di repo
# .keras hanya dipakai lokal untuk training/testing, tidak perlu di-push
ml-model/model/*.keras

# Model .tflite BOLEH di-commit karena ukurannya kecil (~2-3MB) dan
# dibutuhkan langsung oleh aplikasi Flutter. Baris di bawah untuk jaga-jaga
# kalau suatu saat model membesar dan lebih baik disimpan di Git LFS/Drive:
# ml-model/model/*.tflite

# Output hasil prediksi (bersifat sementara, tidak perlu disimpan di repo)
ml-model/output/*.json

# ---------- FLUTTER / DART ----------

# File umum Flutter
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/

# Ephemeral files (dibuat otomatis Flutter, tidak perlu di-commit)
flutter-app/**/*.g.dart
flutter-app/ios/Flutter/.last_build_id

# Android
flutter-app/**/android/**/gradle-wrapper.jar
flutter-app/**/android/.gradle
flutter-app/**/android/captures/
flutter-app/**/android/gradlew
flutter-app/**/android/gradlew.bat
flutter-app/**/android/local.properties
flutter-app/**/android/**/GeneratedPluginRegistrant.java
flutter-app/**/android/key.properties
flutter-app/**/android/**/*.keystore
flutter-app/**/android/**/*.jks

# iOS
flutter-app/**/ios/**/*.mode1v3
flutter-app/**/ios/**/*.mode2v3
flutter-app/**/ios/**/*.moved-aside
flutter-app/**/ios/**/*.pbxuser
flutter-app/**/ios/**/*.perspectivev3
flutter-app/**/ios/**/*sync/
flutter-app/**/ios/**/.sconsign.dblite
flutter-app/**/ios/**/.tags*
flutter-app/**/ios/**/.vagrant/
flutter-app/**/ios/**/DerivedData/
flutter-app/**/ios/**/Icon?
flutter-app/**/ios/**/Pods/
flutter-app/**/ios/**/.symlinks/
flutter-app/**/ios/**/profile
flutter-app/**/ios/**/xcuserdata
flutter-app/**/ios/.generated/
flutter-app/**/ios/Flutter/App.framework
flutter-app/**/ios/Flutter/Flutter.framework
flutter-app/**/ios/Flutter/Flutter.podspec
flutter-app/**/ios/Flutter/Generated.xcconfig
flutter-app/**/ios/Flutter/ephemeral/
flutter-app/**/ios/Flutter/app.flx
flutter-app/**/ios/Flutter/app.zip
flutter-app/**/ios/Flutter/flutter_assets/
flutter-app/**/ios/Flutter/flutter_export_environment.sh
flutter-app/**/ios/ServiceDefinitions.json
flutter-app/**/ios/Runner/GeneratedPluginRegistrant.*

# Coverage
flutter-app/coverage/

# Symbols
flutter-app/app.*.symbols

# Exceptions to above rules
!flutter-app/**/ios/**/default.mode1v3
!flutter-app/**/ios/**/default.mode2v3
!flutter-app/**/ios/**/default.pbxuser
!flutter-app/**/ios/**/default.perspectivev3

# ---------- EDITOR / OS ----------

# VS Code
.vscode/

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# ---------- SENSITIVE / ENV FILES ----------
.env
*.pem
*.key
